# Secrets — never commit
.wikirc.json

# Volatile per-machine state written by /ingest (last-fetched timestamps etc)
.wiki-state/

# Downloaded image BYTES — large binaries, kept local only. Descriptions
# (<n>.md) and .manifest.json ARE committed so future ingests can diff
# against the stored SHA and reuse descriptions instead of re-describing.
raw/images/**/*.png
raw/images/**/*.jpg
raw/images/**/*.jpeg
raw/images/**/*.gif
raw/images/**/*.webp
raw/images/**/*.bmp

# Copied-in local ORIGINALS that are media — kept local only, never committed.
# Documents (.pdf/.docx/.txt/.md/.rtf/.html), spreadsheets (.xlsx/.xls/.csv/
# .tsv/.ods) and presentations (.pptx/.ppt/.odp) are NOT listed here, so they
# are committed and the wiki stays self-contained.
raw/*.png
raw/*.jpg
raw/*.jpeg
raw/*.gif
raw/*.webp
raw/*.bmp
raw/*.svg
raw/*.tiff
raw/*.mp4
raw/*.mov
raw/*.avi
raw/*.mkv
raw/*.webm
raw/*.mp3
raw/*.wav
raw/*.m4a
raw/*.flac
raw/*.ogg

# OS junk
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
.venv/

# Transient
*.tmp
*.bak
/tmp/
